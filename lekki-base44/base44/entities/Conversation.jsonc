{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "espace_id": {
      "type": "string",
      "title": "Espace"
    },
    "title": {
      "type": "string",
      "title": "Titre"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "title": "Dernier message"
    }
  },
  "required": [
    "espace_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}