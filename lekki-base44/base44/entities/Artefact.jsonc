{
  "name": "Artefact",
  "type": "object",
  "properties": {
    "espace_id": {
      "type": "string",
      "title": "Espace"
    },
    "type": {
      "type": "string",
      "title": "Type",
      "enum": [
        "fiche",
        "quiz",
        "carte",
        "audio"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "purple"
      ]
    },
    "title": {
      "type": "string",
      "title": "Titre"
    },
    "content": {
      "type": "string",
      "title": "Contenu"
    },
    "audio_url": {
      "type": "string",
      "title": "Audio"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Sources"
    }
  },
  "required": [
    "espace_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}