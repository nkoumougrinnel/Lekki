# Copier vers .env à la racine du projet :
#   cp .env.example .env
#
# Renseigner au minimum GEMINI_API_KEY pour le chatbot RAG (/ask).

# --- Sécurité ---
SECRET_KEY=change-this-in-production
DEBUG=false
SEED_PASSWORD=lekki123

# --- LLM (au moins une clé pour /ask) ---
# Clé unique OU liste pour la rotation (JSON ou valeurs séparées par virgules).
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
# GEMINI_API_KEYS=["key1","key2","key3"]
# GROQ_API_KEYS=["key1","key2"]
# CEREBRAS_API_KEYS=["key1"]

LLM_PROVIDER_ORDER=gemini,groq,cerebras
LLM_PROVIDER_COOLDOWN_MINUTES=60
LLM_KEY_COOLDOWN_MINUTES=5
LLM_REQUEST_TIMEOUT=120

GEMINI_LLM_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
CEREBRAS_LLM_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
EMBEDDING_PROVIDER_ORDER=gemini

# --- Ollama (filet de sécurité local, DERNIER recours) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.7
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=1024

# --- Interne ---
INTERNAL_API_KEY=lekki-internal-secret-key

# --- Frontend (build Docker — URL vue par le navigateur) ---
VITE_API_URL=http://localhost:8000/api/v1
