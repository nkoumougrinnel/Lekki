# Copier vers .env à la racine du projet :
#   cp .env.example .env
#
# Renseigner au minimum GEMINI_API_KEY pour le chatbot RAG (/ask).

# --- Sécurité ---
SECRET_KEY=change-this-in-production
DEBUG=false
SEED_PASSWORD=lekki123

# --- LLM (au moins une clé pour /ask) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

LLM_PROVIDER_ORDER=gemini,groq,cerebras
LLM_PROVIDER_COOLDOWN_MINUTES=60

GEMINI_LLM_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
CEREBRAS_LLM_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
EMBEDDING_PROVIDER_ORDER=gemini

# --- Interne ---
INTERNAL_API_KEY=lekki-internal-secret-key

# --- Frontend (build Docker — URL vue par le navigateur) ---
VITE_API_URL=http://localhost:8000/api/v1
