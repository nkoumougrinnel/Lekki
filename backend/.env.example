# --- Sécurité ---

SECRET_KEY=change-this-in-production

DEBUG=true

SEED_PASSWORD=lekki123



# --- Fournisseurs LLM distants (bascule automatique) ---

# Ordre de priorité pour la génération (/ask) : gemini → groq → cerebras
# (Ollama est TOUJOURS le dernier recours, jamais à indiquer ici.)

LLM_PROVIDER_ORDER=gemini,groq,cerebras

# Cooldown après quota / 429 (minutes) — cache des fournisseurs défaillants
LLM_PROVIDER_COOLDOWN_MINUTES=60
# Cooldown par CLÉ en échec (rotation) : ne pas réessayer pendant N minutes
LLM_KEY_COOLDOWN_MINUTES=5
# Timeout des appels LLM cloud (secondes)
LLM_REQUEST_TIMEOUT=120



# Google Gemini — https://aistudio.google.com/apikey
# Clé unique OU liste pour la rotation (JSON ou valeurs séparées par virgules).

GEMINI_API_KEY=AIzaSyC8wJr4YfZTQbUJWtCk55tQO0L_wT5xWmU
# GEMINI_API_KEYS=["key1","key2","key3"]

GEMINI_LLM_MODEL=models/gemini-2.0-flash

GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001



# Groq — https://console.groq.com/keys

GROQ_API_KEY=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
# GROQ_API_KEYS=["key1","key2"]

GROQ_LLM_MODEL=llama-3.1-8b-instant

GROQ_BASE_URL=https://api.groq.com/openai/v1



# Cerebras — https://cloud.cerebras.ai

CEREBRAS_API_KEY=csk-f4n8hj8rt6kk6yt4dv5t9md3ntjtw6jfy9htjv2983th9hh5
# CEREBRAS_API_KEYS=["key1"]

CEREBRAS_LLM_MODEL=llama-3.3-70b

CEREBRAS_BASE_URL=https://api.cerebras.ai/v1



# --- Ollama (filet de sécurité local, DERNIER recours uniquement) ---
# Si OLLAMA_ENABLED=false : erreur propre quand tout le cloud est indisponible.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
# Modèle léger recommandé : llama3.2:3b ou qwen2.5:3b (jamais un modèle lourd)
OLLAMA_MODEL=llama3.2:3b
# Paramètres très économiques (RAM/CPU minimum)
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.7
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=1024



# Embeddings (indexation + recherche RAG)
# minilm = local all-MiniLM-L6-v2 (sans clé API) ; gemini = fallback distant
EMBEDDING_PROVIDER_ORDER=minilm,gemini
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2



# --- Interne ---

INTERNAL_API_KEY=lekki-internal-secret-key



