# --- Sécurité ---
SECRET_KEY=change-this-in-production
DEBUG=true
SEED_PASSWORD=lekki123

# --- Fournisseurs LLM distants (bascule automatique) ---
# Ordre de priorité pour la génération (/ask) : gemini → groq → cerebras
LLM_PROVIDER_ORDER=gemini,groq,cerebras
# Durée de cooldown après quota / 429 (minutes)
LLM_PROVIDER_COOLDOWN_MINUTES=60

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=models/gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_LLM_MODEL=llama-3.3-70b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Embeddings (indexation RAG) — pour l'instant Gemini uniquement
EMBEDDING_PROVIDER_ORDER=gemini

# --- Interne ---
# INTERNAL_API_KEY=lekki-internal-secret-key

# --- Base (optionnel) ---
# DATABASE_URL=sqlite+aiosqlite:///./data/wiki.db
# SYNC_DATABASE_URL=sqlite:///./data/wiki.db
