# Lekki Wiki Backend Configuration
SECRET_KEY=change-this-super-secret-key-in-production
DEBUG=true
SEED_PASSWORD=lekki123

# Database (SQLite aiosqlite par défaut pour simplicité, ou postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./lekki.db

# LLM & RAG Provider
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# CORS (séparés par virgule)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
